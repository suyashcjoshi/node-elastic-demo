# --- Elastic OTLP ---
OTEL_EXPORTER_OTLP_ENDPOINT=https://<your-project>.ingest.<region>.elastic.cloud:443
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey <your-api-key>
OTEL_SERVICE_NAME=skyward-search
ELASTIC_OTEL_NODE_ENABLE_LOG_SENDING=true

# --- Database ---
# For local dev this is localhost. In Codespaces, DATABASE_URL is injected by
# docker-compose.yml (pointing to the "db" service) BEFORE node reads this file.
# node --env-file does NOT override variables already set in the environment,
# so the Codespace value wins automatically — no manual change needed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skyward

# --- Debug drawer ---
# Set to true to show the "Debug with Elastic" guide drawer on the main page.
# Alternatively, load the page with ?debug=1 without restarting.
SHOW_DEBUG_GUIDE=false

# --- Partner mock servers ---
# Number of fares each partner returns per search.
# At 3000, CHAOS_GAP produces ~700 ms of event-loop blocking.
FARES_PER_PARTNER=3000

# Per-partner base latencies (ms). Each request adds ±100 ms random jitter.
PARTNER_LATENCY_SKYJET=600
PARTNER_LATENCY_AEROLUZ=900
PARTNER_LATENCY_NIMBUS=750
PARTNER_LATENCY_ZEPHYR=700

# Fraction of requests each partner fails at random (0–1)
PARTNER_FAIL_RATE=0.03

# --- Zephyr degraded behaviour (partners.js) ---
# Independent of CHAOS_PARTNER below. true = Zephyr mock adds 4000 ms + 15% 503.
# This simulates a broken third-party API. You can keep this true while setting
# CHAOS_PARTNER=false to show the app-side fix (timeout) without "fixing" Zephyr.
ZEPHYR_DEGRADED=true

# --- Chaos flags (app.js) ---
# Set ENABLE_CHAOS=false to disable all three at once.
# Individual flags override only when ENABLE_CHAOS is not false.
ENABLE_CHAOS=true

# true  → sequential `for (const p of partners) await fetch(p)`  (staircase in traces)
# false → Promise.allSettled (proper fan-out)
CHAOS_STAIRCASE=true

# true  → O(n²) nested-loop dedupe (blocks event loop ~700 ms at FARES_PER_PARTNER=3000)
# false → Map-keyed dedupe O(n)
CHAOS_GAP=true

# true  → app uses no outbound timeout (Zephyr's 4 s latency flows through to the user)
# false → app wraps every fetch in AbortSignal.timeout(2000) → partial results in ≤2 s
CHAOS_PARTNER=true
