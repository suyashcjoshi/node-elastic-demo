# --- Elastic OTLP ---
OTEL_EXPORTER_OTLP_ENDPOINT=https://<your-project>.ingest.<region>.elastic.cloud:443
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey <your-api-key>
OTEL_SERVICE_NAME=skyward-search
ELASTIC_OTEL_NODE_ENABLE_LOG_SENDING=true

# --- Database ---
# For local dev this is localhost. In Codespaces DATABASE_URL is injected by docker-compose
# and wins automatically — no manual change needed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skyward

# --- Partner mock servers ---
# Number of fares each partner returns per search.
# At 3000 the O(n²) dedupe in app.js produces ~700 ms of event-loop blocking.
FARES_PER_PARTNER=3000

# Base latency per partner request (ms). Each request adds ±100 ms jitter.
# Penguin Air (port 4004) ignores this — it always adds 4 s + 15% failure rate.
PARTNER_LATENCY_MS=80

# Random failure rate for PuffinAir, GooseJet, Pelican Air (0–1)
PARTNER_FAIL_RATE=0.03
