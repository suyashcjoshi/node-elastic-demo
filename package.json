{
  "name": "skyward",
  "version": "1.0.0",
  "description": "Skyward flight aggregator — demos Elastic Observability with EDOT Node.js",
  "type": "module",
  "scripts": {
    "seed": "node --env-file=.env src/seed.js",
    "start": "node --env-file=.env --import @elastic/opentelemetry-node src/app.js",
    "start:plain": "node --env-file=.env src/app.js",
    "start:partners": "node --env-file=.env src/partners.js",
    "start:fast": "ENABLE_CHAOS=false PORT=3001 OTEL_SERVICE_NAME=skyward-search-fixed node --env-file=.env --import @elastic/opentelemetry-node src/app.js",
    "stop": "pkill -f src/app.js || true",
    "restart:elastic": "npm run stop && npm start",
    "load": "node load/search.js",
    "load:fast": "LOAD_URL=http://localhost:3001 node load/search.js"
  },
  "dependencies": {
    "@elastic/opentelemetry-node": "^1.17.0",
    "express": "^4.22.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  }
}
